# uv / python
.venv/
__pycache__/
*.py[cod]

# generated data, partitions, node private keys (node_key.pem MUST never be committed)
data/
nodes/
build/
dist/
game/node_modules/
game/.vite/

# runtime
*.log
nohup.out
.DS_Store

# mirrored MediaPipe assets: the binaries are runtime-local, the hash manifest is a tracked pin
static/vendor/*
!static/vendor/mediapipe/
static/vendor/mediapipe/*
!static/vendor/mediapipe/manifest.json
